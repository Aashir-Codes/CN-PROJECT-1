# ==============================================================================
# Clinic Patient Appointment & Intake Portal — Backend Environment Template
# Copy to `backend/.env` and replace placeholders with real values.
# NEVER commit `.env` to Git or include it in the submission ZIP/PDF.
# ==============================================================================

# --- PostgreSQL Connection (SQLAlchemy 2.x) ---
# VM2 (Deployment 1 - bound strictly to localhost):
DATABASE_URL=postgresql+psycopg://clinic_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/clinic_db
# VM3 Docker Compose (Deployment 2 - over `lab-net` bridge network):
# DATABASE_URL=postgresql+psycopg://clinic_app:CHANGE_ME_DB_PASSWORD@db:5432/clinic_db

# --- Network & Health Check Identity ---
# Reported by GET /api/v1/health (never use socket.gethostbyname(socket.gethostname()))
# VM2 = 192.168.67.20 | VM3 Docker = 192.168.67.30
LAB_IP=192.168.67.20

# --- JWT Session Configuration (HS256 inside HttpOnly Cookie) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=1800

# --- Auth Cookie Flags ---
COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Field-Level Encryption at Rest (AES-256-GCM for medical_notes_enc) ---
# Must be a URL-safe or standard Base64-encoded 32-byte (256-bit) key.
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_AES_256_GCM_KEY

# --- Initial Admin Account Seed (used by `python -m scripts.seed_admin`) ---
ADMIN_FULL_NAME=Clinic Administrator
ADMIN_EMAIL=admin@clinic.example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_8_CHARS
